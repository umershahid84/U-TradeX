# Copy to .env.local (git-ignored) to use your own Moomoo account for live data when running locally.
# Requires the Moomoo OpenD gateway running and logged in on this computer.
# Read-only: the app can only ask for quotes and candles; it can never send an order.
MOOMOO_ENABLED=true
MOOMOO_HOST=127.0.0.1
# OpenD's API port (default 11111)
MOOMOO_PORT=11111
# "tcp" uses that API port and needs nothing else. "ws" uses OpenD's separate WebSocket port instead
# (then set MOOMOO_PORT=33333 and MOOMOO_KEY if you set a WebSocket key).
MOOMOO_PROTOCOL=tcp
MOOMOO_KEY=
# true: quotes come only from Moomoo and an error is shown if Moomoo cannot serve them (no delayed Yahoo prices)
MOOMOO_ONLY=true
