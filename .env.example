# Copy to .env.local (git-ignored) to use your own Moomoo account for live quotes when running locally.
# Requires the Moomoo OpenD gateway running on this computer. Read-only: the app never sends orders.
MOOMOO_ENABLED=true
MOOMOO_HOST=127.0.0.1
# OpenD's WebSocket port (OpenD settings; default 33333)
MOOMOO_PORT=33333
# The WebSocket key you set in OpenD, if any (leave empty if you did not set one)
MOOMOO_KEY=
